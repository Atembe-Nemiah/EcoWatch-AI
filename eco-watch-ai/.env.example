# EcoWatch AI Environment Configuration
# Copy this file to .env and fill in your values.

# Server
PORT=3000

# Database
DATABASE_PATH=./data/ecowatch.sqlite

# AI Integration (vision-capable model)
AI_API_KEY=replace_with_your_private_key
AI_MODEL=gemini-2.0-flash
AI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Device Authentication
DEVICE_SECRET=replace_with_a_strong_device_secret

# Session/Auth
SESSION_SECRET=replace_with_a_strong_session_secret

